&lt;div class="highlight"&gt;&lt;pre tabindex="0" style="color:#abb2bf;background-color:#282c34;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;"&gt;&lt;code class="language-go" data-lang="go"&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#e06c75"&gt;consoleWriter&lt;/span&gt; &lt;span style="color:#56b6c2"&gt;:=&lt;/span&gt; &lt;span style="color:#e06c75"&gt;os&lt;/span&gt;.&lt;span style="color:#e06c75"&gt;Stdout&lt;/span&gt; &lt;span style="color:#7f848e"&gt;// os.Stderr &lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#e06c75"&gt;w&lt;/span&gt;, &lt;span style="color:#e06c75"&gt;err&lt;/span&gt; &lt;span style="color:#56b6c2"&gt;:=&lt;/span&gt; &lt;span style="color:#e06c75"&gt;os&lt;/span&gt;.&lt;span style="color:#61afef;font-weight:bold"&gt;OpenFile&lt;/span&gt;(&lt;span style="color:#98c379"&gt;&amp;#34;./app.log&amp;#34;&lt;/span&gt;, &lt;span style="color:#e06c75"&gt;os&lt;/span&gt;.&lt;span style="color:#e06c75"&gt;O_APPEND&lt;/span&gt;|&lt;span style="color:#e06c75"&gt;os&lt;/span&gt;.&lt;span style="color:#e06c75"&gt;O_CREATE&lt;/span&gt;|&lt;span style="color:#e06c75"&gt;os&lt;/span&gt;.&lt;span style="color:#e06c75"&gt;O_RDWR&lt;/span&gt;, &lt;span style="color:#e06c75"&gt;os&lt;/span&gt;.&lt;span style="color:#e06c75"&gt;ModeAppend&lt;/span&gt;|&lt;span style="color:#e06c75"&gt;os&lt;/span&gt;.&lt;span style="color:#e06c75"&gt;ModePerm&lt;/span&gt;)
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#c678dd"&gt;if&lt;/span&gt; &lt;span style="color:#e06c75"&gt;err&lt;/span&gt; &lt;span style="color:#56b6c2"&gt;!=&lt;/span&gt; &lt;span style="color:#e5c07b"&gt;nil&lt;/span&gt; {
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; &lt;span style="color:#e06c75"&gt;log&lt;/span&gt;.&lt;span style="color:#61afef;font-weight:bold"&gt;Fatal&lt;/span&gt;(&lt;span style="color:#e06c75"&gt;err&lt;/span&gt;)
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;}
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#e06c75"&gt;logWriter&lt;/span&gt; &lt;span style="color:#56b6c2"&gt;:=&lt;/span&gt; &lt;span style="color:#e06c75"&gt;io&lt;/span&gt;.&lt;span style="color:#61afef;font-weight:bold"&gt;MultiWriter&lt;/span&gt;(&lt;span style="color:#e06c75"&gt;consoleWriter&lt;/span&gt;, &lt;span style="color:#e06c75"&gt;w&lt;/span&gt;)
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#e06c75"&gt;l&lt;/span&gt; &lt;span style="color:#56b6c2"&gt;:=&lt;/span&gt; &lt;span style="color:#e06c75"&gt;log&lt;/span&gt;.&lt;span style="color:#61afef;font-weight:bold"&gt;New&lt;/span&gt;(&lt;span style="color:#e06c75"&gt;logWriter&lt;/span&gt;, &lt;span style="color:#98c379"&gt;&amp;#34;---&amp;gt;&amp;#34;&lt;/span&gt;, &lt;span style="color:#e06c75"&gt;log&lt;/span&gt;.&lt;span style="color:#e06c75"&gt;LstdFlags&lt;/span&gt;|&lt;span style="color:#e06c75"&gt;log&lt;/span&gt;.&lt;span style="color:#e06c75"&gt;Lshortfile&lt;/span&gt;)
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#e06c75"&gt;l&lt;/span&gt;.&lt;span style="color:#61afef;font-weight:bold"&gt;Println&lt;/span&gt;(&lt;span style="color:#98c379"&gt;&amp;#34;this is a log&amp;#34;&lt;/span&gt;)
&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;</description></item></channel></rss>